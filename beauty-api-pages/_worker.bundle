    const faceHWRatio = faceHeight > 0 ? faceWidth / faceHeight : 0.75;
    const jawRatio = faceWidth > 0 ? jawWidth / faceWidth : 0.75;
    const chinRatio = faceHeight > 0 ? (metrics.chinLength ?? faceHeight * 0.3) / faceHeight : 0.32;
    const scores = {};
