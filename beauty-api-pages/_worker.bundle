      }
      record.lastActiveAt = (/* @__PURE__ */ new Date()).toISOString();
      record.expiresAt = new Date(Date.now() + SESSION_TTL_MS).toISOString();
      await this.kv.put(sessionKey(sessionId), JSON.stringify(record), {
        expirationTtl: Math.floor(SESSION_TTL_MS / 1e3) + 60
      });
      return record;
    } catch {
      return null;
    }
  }
