      uploadId: result.uploadId,
      imageUrl: result.imageKey,
      imageKey: result.imageKey
    }, 200);
  } catch (err) {
    console.error("[beauty/upload] Error:", err);
    return jsonResponse({ success: false, error: "Upload failed" }, 500);
