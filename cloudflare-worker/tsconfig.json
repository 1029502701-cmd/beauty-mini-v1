{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "functions/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.ts",
    "services/**/*.ts"
  ]
}